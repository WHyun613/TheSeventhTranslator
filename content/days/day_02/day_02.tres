[resource]
script = ExtResource("1_day")
day_id = &"day_02"
display_name = "第二天"
start_location = &"translator_desk"
dialogues = {
"day02_marina_glyph_followup": [{
"expression": "neutral",
"speaker": "玩家",
"text": "话说起来，你是本地人吗？"
}, {
"expression": "neutral",
"speaker": "Marina",
"text": "算半个，但是我十来岁就去总督府上学了。除了会说这里的话，能认识一些字，其他的方面和外来人没什么区别。"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "你认识字？我其实怀疑官方词典对你们文字的解读有些偏差，一些地方的解释方式怪怪的。"
}, {
"expression": "neutral",
"speaker": "Marina",
"text": "什么地方？或许你可以给我看看，也许有些文字我认识。"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "......"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "下次吧，有机会我再来问你，现在我有点事。"
}, {
"expression": "neutral",
"speaker": "Marina",
"text": "好吧，我接下来的每天都会在这里等你，我很乐意为你…...为爷爷做些什么。"
}],
"day02_marina_intro": [{
"expression": "urgent",
"speaker": "Marina",
"text": "昨天你的译文审核是关于一位老人吗？他身材比较瘦削，皮肤黝黑，身材不高。这是他的照片。"
}, {
"expression": "neutral",
"speaker": "Marina",
"text": "这位公公是我母亲的教父，我也一直将他当祖父看待，我知道他并没有非法越境。我希望我能够帮到他。我是这里的本地人你想要了解什么都可以来问我。"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "你知道从哪里查找Santa Lucia的边境吗？"
}, {
"expression": "neutral",
"speaker": "Marina",
"text": "档案室应该有更详细的地图，记录了SantaLucia边境变化的全过程。"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "边境变化？"
}, {
"expression": "neutral",
"speaker": "Marina",
"text": "我也只是小时候听母亲说的，关于这个我也不太清楚。"
}],
"day02_marina_leave": [{
"expression": "urgent",
"speaker": "Marina",
"text": "这孩子......得把包还给他，你先去档案室，我马上就到。"
}],
"day02_marina_return": [{
"expression": "neutral",
"speaker": "Marina",
"text": "我来了，那个孩子跑的太快了。"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "我已经从档案室回来了。"
}, {
"expression": "neutral",
"speaker": "Marina",
"text": "你找到地图了吗？是不是真的和母亲说的一样呢…..."
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "我得去和现在的边界对比一下看看。"
}],
"day02_pickpocket": [{
"expression": "Marina",
"speaker": "神秘男孩",
"text": "当心！那小孩在摸你的钱包！"
}, {
"expression": "neutral",
"speaker": "神秘男孩",
"text": "[迅速跑开]"
}, {
"expression": "urgent",
"speaker": "Marina",
"text": "街道的治安不太好，你得把钱包放在能看到的位置。"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "【你的钱包和一个破布袋子都躺在地上，袋子里的一张纸掉在外边】"
}],
"day02_tomas_briefing": [{
"expression": "neutral",
"speaker": "Tomas",
"text": "从今天起，卖盐老人案进入详细复核。原住民案件实行五日审核：前四天核对证据，第五天作出审判。"
}, {
"expression": "neutral",
"speaker": "Tomas",
"text": "详细案卷已经放在桌上。按官方记录核对即可，不要被无关材料干扰。"
}],
"day02_verdict_approve": [{
"expression": "yawn",
"speaker": "Tomas",
"text": "通过。既然你认可官方记录，就继续按流程归档。"
}],
"day02_verdict_question": [{
"expression": "concerned",
"speaker": "Tomas",
"text": "你又提交了存疑？"
}, {
"expression": "concerned",
"speaker": "Tomas",
"text": "……旧边界和文字证据能够相互印证。我会把这两项异议一并上报。"
}]
}
documents = {
"conclusion_day02_border_changed_doc": {
"asset_id": "conclusion_day02_border_changed",
"body": "案卷中的现行田地照片与旧地图相互印证：边界后来向外移动，老人的土地才被纳入 Santa Lucia。",
"title": "结论 03：边界发生变化"
},
"conclusion_day02_hand_protects_doc": {
"asset_id": "conclusion_day02_hand_protects",
"body": "小男孩的画与旧信相互印证：灰碑文中的【手掌】不是占有，而是守护。",
"title": "结论 02：手掌表示守护"
},
