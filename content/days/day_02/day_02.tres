[resource]
script = ExtResource("1_day")
day_id = &"day_02"
display_name = "第二天"
start_location = &"translator_desk"
dialogues = {
"day02_marina_glyph_followup": [{
"expression": "neutral",
"speaker": "Marina",
"text": "那幅画里的手掌不是占有，而是在挡住落向玉米田的血雨——它表示守护。"
}],
"day02_marina_intro": [{
"expression": "urgent",
"speaker": "Marina",
"text": "你就是新来的第七名译者？我在找卖盐老人案的记录。"
}, {
"expression": "neutral",
"speaker": "Marina",
"text": "档案室保存过土地边界的旧图。如果官方边界改过，那里一定会留下痕迹。"
}],
"day02_marina_leave": [{
"expression": "urgent",
"speaker": "Marina",
"text": "我去追那个孩子。你先去档案室，穿过树林就能看到大门。"
}],
"day02_marina_return": [{
"expression": "neutral",
"speaker": "Marina",
"text": "你找到旧地图了？很好。把它和案卷里的现行田地边界对照，也许能证明老人没有越界。"
}],
"day02_pickpocket": [{
"expression": "neutral",
"speaker": "神秘男孩",
"text": "把钱包给我！"
}, {
"expression": "urgent",
"speaker": "Marina",
"text": "站住！"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "地上掉出了一只破布袋、一幅画和 Marina 的钱包。"
}],
"day02_tomas_briefing": [{
"expression": "neutral",
"speaker": "Tomas",
"text": "从今天起，卖盐老人案进入详细复核。原住民案件实行五日审核：前四天核对证据，第五天作出审判。"
}, {
"expression": "neutral",
"speaker": "Tomas",
"text": "详细案卷已经放在桌上。按官方记录核对即可，不要被无关材料干扰。"
}],
"day02_verdict_approve": [{
"expression": "yawn",
"speaker": "Tomas",
"text": "通过。既然你认可官方记录，就继续按流程归档。"
}],
"day02_verdict_question": [{
"expression": "concerned",
"speaker": "Tomas",
"text": "你又提交了存疑？"
}, {
"expression": "concerned",
"speaker": "Tomas",
"text": "……旧边界和文字证据能够相互印证。我会把这两项异议一并上报。"
}]
}
documents = {
"conclusion_day02_border_changed_doc": {
"asset_id": "conclusion_day02_border_changed",
"body": "案卷中的现行田地照片与旧地图相互印证：边界后来向外移动，老人的土地才被纳入 Santa Lucia。",
"title": "结论 03：边界发生变化"
},
"conclusion_day02_hand_protects_doc": {
"asset_id": "conclusion_day02_hand_protects",
"body": "小男孩的画与旧信相互印证：灰碑文中的【手掌】不是占有，而是守护。",
"title": "结论 02：手掌表示守护"
},
"day02_boy_drawing": {
"asset_id": "item_day02_boy_drawing",
"body": "画面中，一只巨大的手掌挡在玉米田上方，像是在阻止红色雨滴落下。",
"presentation": "large_image_with_caption",
"title": "小男孩的画"
},
"day02_case_hint": {
"asset_id": "doc_day02_case_hint",
"body": "要判断老人是否越界，需要寻找过去土地边界的记录。你可以直接认可官方结论，也可以离开译者房间前往档案室调查。",
"title": "调查目标"
},
"day02_elder_photo": {
"asset_id": "doc_day02_elder_photo",
"body": "Marina 带来的一张旧照片。老人站在一片玉米田旁。",
"title": "卖盐老人照片"
},
"day02_field_photo": {
"asset_id": "item_day02_field_photo",
"body": "照片标出了官方现行边界：老人的玉米田位于现在划定的 Santa Lucia 国有土地范围内。

[美术要求：请在图片中清楚表现现行边界与图例。]",
"title": "案卷附件：田地照片"
},
"day02_old_letter": {
"asset_id": "item_day02_old_letter",
"body": "旧信反复提到：‘伸开的手掌会护住种子，挡住从天而降的血。’",
"title": "档案室旧信"
},
"day02_old_map": {
"asset_id": "item_day02_old_map",
"body": "旧地图上的国有土地边界比案卷照片中的现行边界更小；老人的玉米田原本位于边界之外。",
"title": "Santa Lucia 旧地图"
},
"day02_wallet": {
"asset_id": "item_day02_wallet",
"body": "一个磨旧的钱包。它不属于推理证据，之后应该还给 Marina。",
"title": "Marina 的钱包"
},
