script = ExtResource("1_day")
dialogues = {
"coachman_intro": [{
"expression": "neutral",
"speaker": "玩家",
"text": "这里以前是玉米地？"
}, {
"expression": "neutral",
"speaker": "马车夫",
"text": "现在也是。"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "但是我没有看见玉米。"
}, {
"expression": "neutral",
"speaker": "马车夫",
"text": "玉米在检查站下面，档案馆下面，整个镇子的下面都是玉米地。"
}, {
"expression": "neutral",
"speaker": "玩家",
"text": "但我在地图上并没有看到它们。"
}, {
"expression": "neutral",
"speaker": "马车夫",
"text": "因为玉米不会说它们在这里，但它们就在这里等待。"
}],
"tomas_case_intro": [{
"expression": "neutral",
"speaker": "Tomas",
"text": "今天这份很简单，是边界案。记住我说的话，译文审核遵照词典就好，别给自己添加工作量。"
}],
"tomas_onboarding": [{
"expression": "neutral",
"speaker": "Tomas",
"text": "尊敬的新译者，您好。由于您出色的灰碑文语言能力和沟通能力，恭喜您成为 Santa Lucia 的第七位译者。"
}, {
"expression": "neutral",
"speaker": "Tomas",
"text": "您的职责是核对这些原住民文字和审判理由的对应度。具体翻译请参考这本《灰碑文标准辞典》。"
}, {
"expression": "neutral",
"speaker": "Tomas",
"text": "记住，要照词典翻译，不要解释。"
}],
"tomas_verdict_approve": [{
"expression": "yawn",
"speaker": "Tomas",
"text": "好——非常好。你的工作就是这么简单。"
}],
"tomas_verdict_question": [{
"expression": "concerned",
"speaker": "Tomas",
"text": "才刚来一天就开始找麻烦了？"
}, {
"expression": "concerned",
"speaker": "Tomas",
"text": "……好吧，今天你标记存疑的部分确实有点问题。我会按照流程上报你的修改和证据。"
}]
}
documents = {
"case_hint": {
"asset_id": "doc_case_salt_elder",
"body": "你可以找一找线索，证实译文是否准确。

你也可以直接认可官方译文，但案件一旦提交便不能撤回。",
"title": "提示"
},
"conclusion_no_illegal_crossing": {
"asset_id": "ui_reasoning_board",
"body": "[center][font_size=42]推理成立[/font_size][/center]

缺口圆表示“没有”；它与案卷中的越境符号组合后，原句应理解为：

[center][font_size=36]老人没有非法越境[/font_size][/center]

该结论已作为证据加入物品栏。",
"title": "结论 01"
},
"marina_note": {
"asset_id": "item_day01_marina_note",
"body": "[center][font_size=40]缺口圆不是装饰，
它表示没有。[/font_size]

—— mari[/center]",
"title": "神秘纸条"
},
"official_dictionary": {
"asset_id": "doc_official_dictionary_v4",
"body": "",
"timeline_marker_asset_id": "ui_dictionary_time_marker",
"timeline_page_asset_ids": ["doc_official_dictionary_v4", "doc_dictionary_timeline_02", "doc_dictionary_timeline_03"],
"timeline_track_asset_id": "ui_dictionary_time_track",
